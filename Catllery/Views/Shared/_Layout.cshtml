<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Catllery</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a asp-action="Index"><img src="~/Pictures/catllery_LOGO.png" class="logo" alt="Catllery Logo" /></a>
        <h2>The best cat gallery in the universe... by Gagz</h2>
    </header>
        <main>
        @RenderBody()
        </main>

    <footer>
        &copy; 2024 - Catllery - Privacy
    </footer>
 
</body>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</html>
